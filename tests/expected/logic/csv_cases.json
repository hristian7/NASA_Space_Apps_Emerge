    "bodyRowsIfFlagsJoinedByCommaAndQuoted": "2000,11,hot,238,167,309,estimated_terra,example\n2000,12,hot,0,0,0,estimated_terra,\n2012,2,hot,1234,1100,1300,measured,\"example,partial_month\"\n2022,7,hot,,,,,\n2025,12,hot,7,7,7,measured,low_confidence\n",
    "bodyRowsIfFlagsJoinedBySpace": "2000,11,hot,238,167,309,estimated_terra,example\n2000,12,hot,0,0,0,estimated_terra,\n2012,2,hot,1234,1100,1300,measured,example partial_month\n2022,7,hot,,,,,\n2025,12,hot,7,7,7,measured,low_confidence\n"
