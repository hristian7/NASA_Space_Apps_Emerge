  {
   "name": "Rules as checks",
   "input": {
    "unit": "hot",
    "months": [
     {
      "y": 2000,
      "m": 11,
      "value": 238.0,
      "lo": 167.0,
      "hi": 309.0,
      "src": "estimated_terra",
      "flags": [
       "example"
      ]
     },
     {
      "y": 2000,
      "m": 12,
      "value": 0.0,
      "lo": 0.0,
      "hi": 0.0,
      "src": "estimated_terra",
      "flags": []
     },
     {
      "y": 2012,
      "m": 2,
      "value": 1234.4,
      "lo": 1100.0,
      "hi": 1300.0,
      "src": "measured",
      "flags": [
       "example",
       "partial_month"
      ]
     },
     {
      "y": 2022,
      "m": 7,
      "value": null,
      "lo": null,
      "hi": null,
      "src": null,
      "flags": []
     },
     {
      "y": 2025,
      "m": 12,
      "value": 7.0,
      "lo": 7.0,
      "hi": 7.0,
      "src": "measured",
      "flags": [
       "low_confidence"
      ]
     }
    ]
   },
   "expected": {
    "checks": [
     {
      "rule": "no carriage return anywhere",
      "type": "doesNotContain",
      "text": "\r"
     },
     {
      "rule": "every line ends with the line feed character",
      "type": "everyLineEndsWith",
      "text": "\n"
     },
     {
      "rule": "null value, low and high are empty fields",
      "type": "rowEquals",
      "row": "2022,7,hot,,,,,"
     },
     {
      "rule": "zero is the character 0",
      "type": "rowEquals",
      "row": "2000,12,hot,0,0,0,estimated_terra,"
     },
     {
      "rule": "a field with a comma is quoted",
      "type": "csvFieldQuoted",
      "sample": "a,b",
      "quoted": "\"a,b\""
     },
     {
      "rule": "column count is 8 in every body row",
      "type": "fieldCount",
      "count": 8,
      "note": "except rows where a quoted field holds commas"
     },
     {
      "rule": "a fire value is never printed with a decimal point",
      "type": "doesNotMatch",
      "pattern": "\\.\\d"
     }
    ]
   }
