      "lo": 0.5,
      "hi": 3.5,
      "src": "measured",
      "flags": []
     },
     {
      "y": 2020,
      "m": 2,
      "value": 1.5,
      "lo": 1.49,
      "hi": 1.51,
      "src": "measured",
      "flags": []
     },
     {
      "y": 2020,
      "m": 3,
      "value": 0.4999,
      "lo": 0.0,
      "hi": 0.5,
      "src": "measured",
      "flags": []
     },
     {
      "y": 2020,
      "m": 4,
      "value": 0.0,
      "lo": 0.0,
      "hi": 0.0,
      "src": "measured",
      "flags": []
     }
