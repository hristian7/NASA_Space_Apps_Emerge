   "expected": {
    "bodyRowsIfHalfRoundsUp": "2020,1,hot,3,1,4,measured,\n2020,2,hot,2,1,2,measured,\n2020,3,hot,0,0,1,measured,\n2020,4,hot,0,0,0,measured,\n",
    "bodyRowsIfHalfRoundsToEven": "2020,1,hot,2,0,4,measured,\n2020,2,hot,2,1,2,measured,\n2020,3,hot,0,0,0,measured,\n2020,4,hot,0,0,0,measured,\n"
   },
   "ambiguity": "Section 8 says 'rounded to whole numbers' without a tie rule (JavaScript Math.round rounds halves up; Python round goes to even). Weighted values such as 2.5 occur. Both are given. Values like 0.4999 and 1.49 round the same either way."
