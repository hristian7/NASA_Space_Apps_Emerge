lished_ratios":[{"scope":"world","unit":"cd","ours":2.7,"published":null,"published_source":null,"note":"Our measured worldwide S-NPP to MODIS fire-cell-day ratio."}],"range_coverage":[{"level_pct":90,"unit":"cd","scope":"cell_month","country":"Bulgaria","test":"t1","n":11616,"observed_pct":94.6798},{"level_pct":90,"unit":"hot","scope":"cell_month","country":"Bulgaria","test":"t1","n":11616,"observed_pct":94.4473},{"level_pct":90,"unit":"cd","scope":"cell_month","country":"United_States","test":"t1","n":689952,"observed_pct":94.7325},{"level_pct":90,"unit":"hot","scope":"cell_month","country":"United_States","test":"t1","n":689952,"observed_pct":94.0934},{"level_pct":90,"unit":"cd","scope":"cell_month","country":"Bulgaria","test":"t2","n":11374,"observed_pct":94.2413},{"level_pct":90,"unit":"hot","scope":"cell_month","country":"Bulgaria","test":"t2","n":11374,"observed_pct":94.4347},{"level_pct":90,"unit":"cd","scope":"cell_month","country":"United_States","test":"t2","n":675578,"observed_pct":95.0807},{"level_pct":90,"unit":"hot","scope":"cell_month","country":"United_States","test":"t2","n":675578,"observed_pct":94.8255},{"level_pct":90,"unit":"cd","scope":"cell_month","country":"Bulgaria","test":"t3","n":8712,"observed_pct":96.5106},{"level_pct":90,"unit":"hot","scope":"cell_month","country":"Bulgaria","test":"t3","n":8712,"observed_pct":95.3857},{"level_pct":90,"unit":"cd","scope":"cell_month","country":"United_States","test":"t3","n":517464,"observed_pct":93.6173},{"level_pct":90,"unit":"hot","scope":"cell_month","country":"United_States","test":"t3","n":517464,"observed_pct":94.2355}],"chance_of_fire":{"brier":null,"reliability":[{"bin":[0.0,0.1],"predicted":null,"observed":null,"n":null},{"bin":[0.1,0.2],"predicted":null,"observed":null,"n":null},{"bin":[0.2,0.3],"predicted":null,"observed":null,"n":null},{"bin":[0.3,0.4],"predicted":null,"observed":null,"n":null},{"bin":[0.4,0.5],"predicted":null,"observed":null,"n":null},{"bin":[0.5,0.6],"predicted":null,"observed":null,"n":null},{"bin":[0.6,0.7],"predicted":null,"observed":null,"n":null},{"bin":[0.7,0.8],"predicted":null,"observed":null,"n":null},{"bin":[0.8,0.9],"predicted":null,"observed":null,"n":null},{"bin":[0.9,1.0],"predicted":null,"observed":null,"n":null}]},"control_totals":[{"check":"the scorer's hand-computed truth samples match the raw files","passed":true,"detail":"matches exactly"},{"check":"exported tile totals equal the conversion's own totals","passed":true,"detail":"checked by the contract test at export time"},{"check":"daily totals equal monthly totals (V-M125)","passed":null,"detail":"not recomputed by the scorer"}],"limits":[{"id":"cell-size","text":"Harmonized numbers exist per 0.25 degree cell, about 28 km across. A smaller area still reports the whole cell, so it is labelled low confidence."},{"id":"tested-on-two-countries","text":"The independent test covered Bulgaria and the United States, and it fitted the conversion on those two countries alone. Every score on this page comes from that test. The numbers in the app come from the same model fitted on all 235 countries, and its own test is still being run, so treat the scores here as evidence about the method rather than about every country."},{"id":"small-countries-wide-ranges","text":"A small country has a wide range. Across Bulgaria's estimated months the upper end sits about 3.8 times the value, while for the United States it is about 1.25 times. That is the model's honest spread once it is pooled across 235 countries: fewer fires mean less to learn from, so the range widens. Nothing has been narrowed to make it look better."},{"id":"summed-ranges-are-too-wide","text":"A yearly or worldwide range is the sum of the monthly ranges underneath it. Adding ranges that way assumes every month is wrong in the same direction at once, which is unlikely, so a total's range is wider than the truth needs. Read a total's range as an outer bound, not as a likely spread."},{"id":"one-gate-miss","text":"One world-gate check was missed: the Bulgaria error on the first hold-out at country level is above the limit we set ourselves. It is reported here rather than hidden, and the team decided to go ahead."},{"id":"single-cell-error","text":"A single 0.25 degree cell in a single month is far less reliable than a region or a country. The error at cell level is several times the error at country level, which is why the app shows a range."},{"id":"before-2012","text":"Nothing like VIIRS flew before 20 January 2012. Values before February 2012 are converted from MODIS and carry a range, not a single certain number."},{"id":"background","text":"Before February 2012 a cell that lists no fire for a month still carries a small background value, because the old sensors often saw nothing where the newer one would have seen fire."},{"id":"short-windows","text":"Counts over fewer than eight days are strongly biased by the satellite's orbit, so the app never compares a run shorter than that."},{"id":"daily-raw","text":"The daily numbers are raw counts from the sensor flying at the time, not converted ones, so a year before 2012 cannot be compared with a later year without scaling. The app marks those years estimated."},{"id":"country-edges","text":"Country files use the data provider's own country for each detection, so cells on a border can differ slightly from a drawn outline."},{"id":"industrial","text":"Static industrial heat sources are filtered out, so gas flares and similar sites are not counted as fires."},{"id":"frp-not-harmonized","text":"Fire radiative power is the reference sensor's own total, not converted between sensors, so it steps at the sensor change."},{"id":"not-a-warning","text":"This is a research prototype built from past detections. It is not an official warning service."}]}
