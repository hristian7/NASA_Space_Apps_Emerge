# Secrets: the FIRMS MAP_KEY lives here, never in git
.env
.env.*
local-etc

# Graphify output: local knowledge graph, rebuild with /graphify .
graphify-out/

# OS and editor
.DS_Store

# Python
__pycache__/
.venv/
*.pyc

# Data downloads (re-downloadable, can be large)
data/raw/

# Computed totals (rebuild with pipeline/build_cells.py)
data/derived/

# Vercel link and local env files (hold tokens), never in git
.vercel
.env*

# Prediction engine working files (rebuild with engine/*.py); results go to docs/engine-results/
engine/fire/
engine/weather/
engine/power/
engine/idx/
engine/*.csv
engine/*.json
engine/*.png
engine/*.log
engine/verify/*.csv
engine/*.txt
!engine/countries.txt
engine/rerun.sh
.hypothesis/
engine/.hypothesis/
.coverage
