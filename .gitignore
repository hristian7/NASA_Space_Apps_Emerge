# Secrets: the FIRMS MAP_KEY lives here, never in git
.env
.env.*
local-etc

# Graphify output: local knowledge graph, rebuild with /graphify .
graphify-out/

# OS and editor
.DS_Store

# Python
__pycache__/
.venv/
*.pyc

# Data downloads (re-downloadable, can be large)
data/raw/

# Computed totals (rebuild with pipeline/build_cells.py)
data/derived/

# Vercel link and local env files (hold tokens), never in git
.vercel
.env*

# Next.js app in web/ (installed or built, rebuild with npm install and npm run build)
web/node_modules/
web/.next/
web/test-results/
web/playwright-report/
web/*.tsbuildinfo

# Written by the framework on every dev and build run
web/next-env.d.ts
